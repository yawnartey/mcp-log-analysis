# Copy this file to .env and fill in your own values. Never commit .env.

# Comma-separated list of host names. Each name maps to the <HOST> suffix
# below: upper-cased, with "-" replaced by "_" (e.g. web-dev -> WEB_DEV).
DIR_HOSTS=web-dev,web-prod

# Defaults used when a host doesn't set its own user/port/key
SSH_USER=your-ssh-user
SSH_KEY=~/.ssh/id_ed25519
# SSH_PORT=22

# web-dev
SSH_HOST_WEB_DEV=dev.example.com
FILE_ALLOWED_DIRS_WEB_DEV=/var/log,/home/your-ssh-user

# web-prod
SSH_HOST_WEB_PROD=prod.example.com
FILE_ALLOWED_DIRS_WEB_PROD=/var/log
# SSH_USER_WEB_PROD=another-user
# SSH_PORT_WEB_PROD=2222
# SSH_KEY_WEB_PROD=~/.ssh/prod_key

# Local folders that download_file/upload_file may use (subfolders included).
# Leave unset to disable file transfers.
LOCAL_TRANSFER_DIRS=~/Downloads/mcp-transfers

# Max transfer size in bytes (default 10 GB)
# MAX_TRANSFER_BYTES=10737418240

# Optional tuning
# FILE_MAX_OUTPUT_CHARS=100000
# SEARCH_TIMEOUT_SECONDS=120
